# Провайдер для LLM: ollama, vllm, openai
LLM_PROVIDER=vllm

# Конфигурация LLM
CONTEXT_WINDOW=32768
NUM_OUTPUT=4096
REQUEST_TIMEOUT=120
TEMPERATURE=0.7

# Конфигурация Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# Конфигурация vLLM
VLLM_URL_BASE=http://localhost:9999
VLLM_API_KEY=vllm-api-key
VLLM_MODEL=gemma-4

# Конфигурация OpenAI
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-5.4

# Модель для guardrails
GUARD_MODEL=gemma-4

# Конфигурация модели эмбеддингов
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Конфигурация баз данных
CORPUS_PATH=corpus/

QDRANT_URL=http://localhost:6333
QDRANT_PATH=qdrant_data/

REDIS_URL=redis://localhost:6379

COLLECTION_NAME=ableton_docs

# Конфигурация компонента извлечения информации
CHUNK_SIZE=512
CHUNK_OVERLAP=64

SIMILARITY_TOP_K=5

# Конфигурация Telegram-бота
TELEGRAM_BOT_TOKEN=telegram-bot-token
API_BASE_URL=http://localhost:8000
